# ==============================================================================
# Git Ignore - Automation AI (Root, Backend, & Frontend)
# ==============================================================================

# --- Dependencies ---
node_modules/
*/node_modules/
.pnp
.pnp.js

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

# Firebase & Cloud Credentials
serviceAccountKey.json
REAL-firebase.js
**/serviceAccountKey.json
firebase-adminsdk*.json
**/firebase-adminsdk*.json
client_secret*.json
credentials.json
*.pem
*.key
*.cert
*.crt

# --- Production & Build Outputs ---
dist/
*/dist/
dist-ssr/
build/
out/
.next/
.turbo/

# --- Logs & Runtime Data ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Cache & Temporary Files ---
.cache/
.eslintcache
.parcel-cache/
*.tsbuildinfo
.npm/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Settings ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
