# ==============================================================================
# Frontend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env or real secret keys to version control!
# ==============================================================================

# Firebase Web API Key (from Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here

# Backend API Base URL
# For local development: http://localhost:5000/api (or http://localhost:8080/api)
# For production (Vercel): /api (or your deployed backend URL)
VITE_SERVER_URL=http://localhost:5000/api
