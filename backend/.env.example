# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env or real secret keys to version control!
# ==============================================================================

# Server Port (Defaults to 5000 if not specified)
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URL=mongodb://localhost:27017/cortexa_ai

# JWT Secret Key for Session Authentication & Cookie Signing
JWT_SECRET=your_super_secret_jwt_key_here

# Groq API Key (for LLM inference via ChatGroq, e.g., qwen/qwen3.8-27b)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API Key (for MCP Web Search Tool)
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Firebase Service Account JSON (Used in cloud/Vercel serverless environments)
# In local development, placing serviceAccountKey.json in the backend/ root is sufficient.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"..."}
